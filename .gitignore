# Sensitive per-application source material and generated dataset files
data/*/

# Application profiles may contain local runtime settings. Keep only the
# shareable template under version control.
configs/apps/*.yaml
!configs/apps/app.template.yaml

# Large, reproducible local assets
models/
outputs/
logs/
.cache/

# Vendored upstream repositories are pinned in SOURCES.md instead
third_party/

# Local upstream repositories used only for implementation reference
reference/

# Python and editor state
.venv/
__pycache__/
*.py[cod]
.DS_Store

# Local working notes
record.txt
